# Server
PORT=3000

# Vector store (Qdrant) — local Docker or Qdrant Cloud
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Generation: OpenRouter (OpenAI-compatible). Get a key at https://openrouter.ai/keys
OPEN_ROUTER_API_KEY=
OPEN_ROUTER_MODEL=openai/gpt-4o-mini

# Embeddings: OpenRouter embeddings model (or OpenAI-compatible)
EMBEDDING_MODEL=openai/text-embedding-3-small

# Anthropic Claude configuration
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Source databases for ingestion (Postgres connection strings)
# Append ?sslmode=require for managed/cloud Postgres.
LEAD_DATABASE_URL=postgres://user:pass@host:5432/lead_service
BOQ_DATABASE_URL=postgres://user:pass@host:5432/boq_service

# Where incremental-sync watermarks are stored (per-source last updated_at)
INGEST_STATE_DIR=.ingest-state
