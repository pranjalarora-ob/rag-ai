# Server
PORT=3000

# Vector store (Qdrant) — local Docker or Qdrant Cloud
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Generation: OpenRouter (OpenAI-compatible). Get a key at https://openrouter.ai/keys
OPEN_ROUTER_API_KEY=

# Embeddings: Google Gemini (gemini-embedding-001, 3072 dims). Embedding quota is separate from chat.
GEMINI_API_KEY=
